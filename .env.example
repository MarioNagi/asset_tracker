# Local development defaults
DJANGO_DEPLOYMENT_TARGET=self_hosted
DJANGO_DEBUG=true
DJANGO_LOG_LEVEL=INFO
DJANGO_SECRET_KEY=replace-with-a-long-random-development-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Australia/Sydney
DJANGO_SESSION_EXPIRE_AT_BROWSER_CLOSE=true
DJANGO_SESSION_SAVE_EVERY_REQUEST=false

# Production database. SQLite is for local development and the
# PythonAnywhere target; switch to MySQL for self-hosted production.
DJANGO_DATABASE_ENGINE=sqlite
DJANGO_DATABASE_NAME=db.sqlite3
# DJANGO_DATABASE_ENGINE=mysql
# DJANGO_DATABASE_NAME=asset_tracker
# DJANGO_DATABASE_USER=asset_tracker
# DJANGO_DATABASE_PASSWORD=replace-with-a-secret
# DJANGO_DATABASE_HOST=mysql.internal
# DJANGO_DATABASE_PORT=3306
# DJANGO_DATABASE_SSL_CA=C:\path\to\provider-ca.pem

# Two-factor authentication. Admin and Manager enrollment is required by default.
# Add User to require it for every account: Admin,Manager,User
DJANGO_MFA_REQUIRED_ROLES=Admin,Manager
DJANGO_MFA_TOTP_ISSUER=Koinonia Asset Tracker

# Email: keep the console backend for local development.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_TIMEOUT=20
DJANGO_DEFAULT_FROM_EMAIL=Koinonia Enterprises <no-reply@koinonia.com>
DJANGO_FLEET_MANAGER_EMAIL=fleet.manager@example.com

# Scheduled reminders. Self-hosted deployments run Celery worker + Beat
# against Redis. PythonAnywhere cannot host long-lived processes, so set
# DJANGO_USE_CELERY=false there and call ``manage.py run_scheduled_tasks``
# from a PythonAnywhere scheduled task instead.
DJANGO_USE_CELERY=true
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_TASK_TIME_LIMIT=300
CELERY_RESULT_EXPIRES=86400
# Leave DJANGO_CACHE_URL empty to use the local-memory cache. PythonAnywhere
# uses the local-memory cache by default; paid Memcached is the only Redis
# replacement available there.
DJANGO_CACHE_URL=
DJANGO_CACHE_LOCATION=asset-tracker-development

# Production security: enable only after confirming HTTPS is working.
# The PythonAnywhere target defaults to the safe values; the self-hosted
# target keeps DEBUG-driven defaults so a local server can still run.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_X_FRAME_OPTIONS=DENY
DJANGO_BEHIND_HTTPS_PROXY=false
DJANGO_SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
# Keep this synchronized with any approved external asset providers.
DJANGO_CONTENT_SECURITY_POLICY=default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self' data: https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src 'self'
DJANGO_STATIC_ROOT=staticfiles
DJANGO_MEDIA_ROOT=media
